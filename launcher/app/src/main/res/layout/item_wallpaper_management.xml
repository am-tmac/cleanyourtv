<?xml version="1.0" encoding="utf-8"?>
<!-- One focusable row: OK opens a deletion confirmation. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:background="@drawable/switch_row_bg"
    android:focusable="true"
    android:clickable="true">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="96dp"
        android:layout_height="54dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        android:duplicateParentState="true">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:duplicateParentState="true"
            android:textSize="18sp"
            android:fontFamily="@font/outfit_medium"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#8CFFFFFF"
            android:duplicateParentState="true"
            android:textSize="14sp"
            android:fontFamily="@font/outfit"
            android:singleLine="true"
            android:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/currentBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:padding="6dp"
        android:background="@drawable/switch_row_bg"
        android:text="@string/wallpaper_current"
        android:textColor="#FFB7EBCF"
        android:textSize="14sp" />
</LinearLayout>
