<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS everywhere, except ip-api.com's free tier, which only serves plain HTTP (weather line city fallback). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">ip-api.com</domain>
    </domain-config>
</network-security-config>
